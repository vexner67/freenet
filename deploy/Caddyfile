# The website: Caddy in front of the gateway. SITE_ADDRESS is the domain
# (HTTPS with a certificate Caddy gets and renews itself, HTTP redirected
# to it) or ":80" without one. REDIRECT_ADDRESS, www.<domain>, leads to
# it: the site has one address, so signing in holds wherever one comes
# from; without a domain it is an internal port nobody reaches.
{
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# The gateway trusts X-Request-ID from its proxy (TRUST_FORWARDED_FOR):
	# Caddy gives every request its own, never the client's.
	reverse_proxy gateway:8080 {
		header_up X-Request-ID {http.request.uuid}

		# A deployment restarts the gateway: a request that cannot reach
		# it waits for the new one instead of failing. Only a request not
		# sent yet is tried again.
		lb_try_duration 30s
		lb_try_interval 500ms
	}

	header {
		-Server
		# Browsers keep to HTTPS once they have seen it; ignored over HTTP.
		Strict-Transport-Security "max-age=31536000"
	}

	log {
		output stdout
		format json
	}
}

{$REDIRECT_ADDRESS::8081} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}
