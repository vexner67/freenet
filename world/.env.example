GRPC_PORT=
LOG_LEVEL=
LOG_FORMAT=
# Prometheus metrics at :METRICS_PORT/metrics, not to be published
# outside; empty = not served.
METRICS_PORT=

# mTLS between services (all three or none; none = plaintext, local only).
# `make certs` in the repository root creates them in certs/.
TLS_CA_PATH=
TLS_CERT_PATH=
TLS_KEY_PATH=

# inmem (default, nothing to run) | persistent (PostgreSQL)
STORAGE=
DATABASE_URL=
# Apply migrations on start (default true).
MIGRATE_ON_START=

# Where the votes of the states are taken and paid.
USER_SERVICE_ADDR=
# Where the groups of the states are made. Without it they have none.
CLUB_SERVICE_ADDR=
# Timeout of one call to another service (default 3s).
CALL_TIMEOUT=

# How often the hours of the world are counted (default 1m).
WORLD_INTERVAL=
# How often a replica looks for a map to make (default 1m).
GENERATE_INTERVAL=
# Width of the map at the closest zoom in pixels, 512 times a power of
# two (default 4096).
TILE_WIDTH=

# Spam protection per user, as "limit/window,...". REDIS_ADDR shares the
# counters between replicas; without it each replica counts on its own.
REDIS_ADDR=
# What people do in the world. Default: 30/1m,300/24h.
RATE_LIMIT_WORLD_ACTIONS=

JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=

# Optional: host:port of a collector taking OTLP over gRPC (Jaeger in the
# Docker stack), for a trace of every request through the services; without
# it nothing is traced. TRACING_SAMPLE_RATIO is the share of requests
# traced, from 0 to 1 (default 1).
TRACING_ENDPOINT=
TRACING_SAMPLE_RATIO=
