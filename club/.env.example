GRPC_PORT=
LOG_LEVEL=
LOG_FORMAT=
# Prometheus metrics at :METRICS_PORT/metrics, not to be published
# outside; empty = not served.
METRICS_PORT=

# mTLS between services (all three or none; none = plaintext, local only).
# `make certs` in the repository root creates them in certs/.
TLS_CA_PATH=
TLS_CERT_PATH=
TLS_KEY_PATH=

# inmem (default, nothing to run) | persistent (PostgreSQL)
STORAGE=
DATABASE_URL=
# Apply migrations on start (default true).
MIGRATE_ON_START=

# Where club tells that someone was made an admin. Without it an
# appointment notifies nobody.
NOTIFICATION_SERVICE_ADDR=
# Timeout of one call to the notification service (default 2s).
NOTIFY_TIMEOUT=
# Where club tells who joined and left a club: the news of post show a
# member the wall of the club. Without it they do not.
POST_SERVICE_ADDR=
# How often post is told anew who is in every club (default 6h): its
# copy, which the news read, is mended after a word lost on the way.
# 0: never. Needs POST_SERVICE_ADDR.
FEED_SYNC_INTERVAL=

# How long before an event starts its members are reminded of it
# (default 24h) and how often the events that are due are looked for
# (default 5m).
EVENT_REMINDER_AHEAD=
EVENT_REMINDER_INTERVAL=

# Spam protection per user, as "limit/window,...". REDIS_ADDR shares the
# counters between replicas; without it each replica counts on its own.
REDIS_ADDR=
# Creating clubs. Default: 3/1h,10/24h.
RATE_LIMIT_CLUBS=
# Changing a club's settings. Default: 10/1m,100/24h.
RATE_LIMIT_CLUB_EDITS=
# Joining clubs. Default: 30/1m,300/24h.
RATE_LIMIT_JOINS=

JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=

# Optional: host:port of a collector taking OTLP over gRPC (Jaeger in the
# Docker stack), for a trace of every request through the services; without
# it nothing is traced. TRACING_SAMPLE_RATIO is the share of requests
# traced, from 0 to 1 (default 1).
TRACING_ENDPOINT=
TRACING_SAMPLE_RATIO=
