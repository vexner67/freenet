GRPC_PORT=
LOG_LEVEL=
LOG_FORMAT=
# Prometheus metrics at :METRICS_PORT/metrics, not to be published
# outside; empty = not served.
METRICS_PORT=

# mTLS between services (all three or none; none = plaintext, local only).
# `make certs` in the repository root creates them in certs/.
TLS_CA_PATH=
TLS_CERT_PATH=
TLS_KEY_PATH=

# inmem (default, nothing to run) | persistent (PostgreSQL)
STORAGE=
DATABASE_URL=
# Apply migrations on start (default true).
MIGRATE_ON_START=

# Optional: without it follows notify nobody.
NOTIFICATION_SERVICE_ADDR=
# The services told to erase a page deleted for good; one left empty keeps
# the data of erased users.
POST_SERVICE_ADDR=
MEDIA_SERVICE_ADDR=
MESSAGE_SERVICE_ADDR=
CLUB_SERVICE_ADDR=
# Timeout of one call to another service (default 2s).
NOTIFY_TIMEOUT=

# Spam protection per user, as "limit/window,...". REDIS_ADDR shares the
# counters between replicas; without it they are kept in memory.
REDIS_ADDR=
# Defaults: 30/1m,300/24h.
RATE_LIMIT_FOLLOWS=
# Gifts sent. Defaults: 10/1m,100/24h.
RATE_LIMIT_GIFTS=
# Transfers of votes. Defaults: 10/1m,100/24h.
RATE_LIMIT_TRANSFERS=
# Vouchers tried. Defaults: 5/1m,30/24h.
RATE_LIMIT_VOUCHERS=
# Packs of stickers made and changed. Defaults: 10/1m,100/24h.
RATE_LIMIT_STICKER_PACKS=
# Views of ads and clicks on them counted. Defaults: 60/1m,3000/24h.
RATE_LIMIT_AD_EVENTS=
# Spins of the casino. Defaults: 30/1m,1000/24h.
RATE_LIMIT_CASINO=
# Digs and sales in the mine, each counted apart. Defaults: 60/1m,3000/24h.
RATE_LIMIT_MINE=
# Actions with the enterprises of "Бизнес". Defaults: 60/1m,3000/24h.
RATE_LIMIT_BUSINESS=
# Deposits and loans put, taken, lent and paid back, each counted apart. Defaults: 30/1m,500/24h.
RATE_LIMIT_BANK=
# Visits of pages written down as guests. Defaults: 120/1m,5000/24h.
RATE_LIMIT_VISITS=
# Pets adopted, fed, played with, renamed and set to fight, each counted
# apart. Defaults: 30/1m,1000/24h.
RATE_LIMIT_PETS=
RATE_LIMIT_CANVAS=
# Collectible gifts upgraded, given away, sold, bought, auctioned and bid
# on, each counted apart. Defaults: 30/1m,500/24h.
RATE_LIMIT_GIFT_MARKET=

# The emails of the administrators of the site, comma-separated: they make
# the vouchers ("Ваучеры"). Empty: nobody does.
ADMIN_EMAILS=

# How long a deleted page can be restored before its data is erased, as a
# Go duration (default 5040h, seven months as on openvk).
ACCOUNT_RETENTION=
# How often the pages that are due are erased (default 1m).
ACCOUNT_PURGE_INTERVAL=
# How often post is told anew whom everybody follows (default 6h): its
# copy, which the news read, is mended after a word lost on the way.
# 0: never. Needs POST_SERVICE_ADDR.
FEED_SYNC_INTERVAL=
# How often the visits of the people on the site are written, all at
# once (default 10s): a person shows as online that much later.
PRESENCE_FLUSH_INTERVAL=
# How often the auctions of gifts that ended are settled (default 30s).
GIFT_AUCTION_INTERVAL=
# How often the loans past their term are collected (default 10m).
BANK_INTERVAL=
# How often the administrators get back the votes they spent (default 1m).
ENDLESS_INTERVAL=
# How often the poker tables nobody reads move on (default 5s).
HOLDEM_INTERVAL=
# How often the economy of the enterprises looks whether an hour ended, to count it (default 1m).
FIRM_INTERVAL=

JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=

# Optional: host:port of a collector taking OTLP over gRPC (Jaeger in the
# Docker stack), for a trace of every request through the services; without
# it nothing is traced. TRACING_SAMPLE_RATIO is the share of requests
# traced, from 0 to 1 (default 1).
TRACING_ENDPOINT=
TRACING_SAMPLE_RATIO=
