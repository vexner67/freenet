AUTH_POSTGRES_USER=
AUTH_POSTGRES_PASSWORD=
AUTH_POSTGRES_DB=
AUTH_POSTGRES_PORT=

USER_POSTGRES_USER=
USER_POSTGRES_PASSWORD=
USER_POSTGRES_DB=
USER_POSTGRES_PORT=

POST_POSTGRES_USER=
POST_POSTGRES_PASSWORD=
POST_POSTGRES_DB=
POST_POSTGRES_PORT=

NOTIFICATION_POSTGRES_USER=
NOTIFICATION_POSTGRES_PASSWORD=
NOTIFICATION_POSTGRES_DB=
NOTIFICATION_POSTGRES_PORT=

MESSAGE_POSTGRES_USER=
MESSAGE_POSTGRES_PASSWORD=
MESSAGE_POSTGRES_DB=
MESSAGE_POSTGRES_PORT=

CLUB_POSTGRES_USER=
CLUB_POSTGRES_PASSWORD=
CLUB_POSTGRES_DB=
CLUB_POSTGRES_PORT=

REDIS_PORT=

# The Docker stack (`make stack`). HASH_SECRET keys the hashes of sign-in
# codes and refresh tokens: a long random string, e.g. openssl rand -hex 32.
HASH_SECRET=
# Optional, default 8080.
GATEWAY_PORT=
# Optional, default 9090: Prometheus of the Docker stack.
PROMETHEUS_PORT=
# Optional, default 9093: Alertmanager of the Docker stack.
ALERTMANAGER_PORT=
# Optional, default 3001: Grafana of the Docker stack, open to look at;
# GRAFANA_ADMIN_PASSWORD (default admin) is for changing it.
GRAFANA_PORT=
GRAFANA_ADMIN_PASSWORD=
# Optional, default 5040h (seven months): how long a deleted page can be
# restored in the Docker stack; shorter to try the erasure.
ACCOUNT_RETENTION=
# Optional, default 24h: how long media keeps a photo uploaded for a post
# that is never published; shorter to try the cleanup.
UNPUBLISHED_PHOTO_TTL=
