GRPC_PORT=
LOG_LEVEL=
LOG_FORMAT=
# Prometheus metrics at :METRICS_PORT/metrics, not to be published
# outside; empty = not served.
METRICS_PORT=

# mTLS between services (all three or none; none = plaintext, local only).
# `make certs` in the repository root creates them in certs/.
TLS_CA_PATH=
TLS_CERT_PATH=
TLS_KEY_PATH=

# inmem (default, nothing to run) | persistent (PostgreSQL)
STORAGE=
DATABASE_URL=
# Apply migrations on start (default true).
MIGRATE_ON_START=

# Spam protection per user, as "limit/window,...". REDIS_ADDR shares the
# counters and live events between replicas; without it they stay in one.
REDIS_ADDR=
# Defaults: 30/1m,1000/24h.
RATE_LIMIT_MESSAGES=
# Creating chats, renaming them and adding people. Defaults: 10/1m,100/24h.
RATE_LIMIT_CHATS=
# Telling that one is typing, in dialogs and in chats. Defaults: 30/1m,5000/24h.
RATE_LIMIT_TYPING=

# Where message tells media which photos its messages publish and delete.
# Without it media deletes the photos of messages as never sent.
MEDIA_SERVICE_ADDR=
# Timeout of one call to the media service (default 2s).
MEDIA_TIMEOUT=

# Where message tells of every new message, to push it to the browsers of
# its recipients. Without it nobody's browsers hear of messages.
NOTIFICATION_SERVICE_ADDR=
# Timeout of one call to the notification service (default 2s).
NOTIFY_TIMEOUT=
# How many pushes may wait for the notification service (default 1000);
# more are dropped.
PUSH_QUEUE=

JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=

# Optional: host:port of a collector taking OTLP over gRPC (Jaeger in the
# Docker stack), for a trace of every request through the services; without
# it nothing is traced. TRACING_SAMPLE_RATIO is the share of requests
# traced, from 0 to 1 (default 1).
TRACING_ENDPOINT=
TRACING_SAMPLE_RATIO=
