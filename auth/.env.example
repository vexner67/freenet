GRPC_PORT=
LOG_LEVEL=
LOG_FORMAT=
# Prometheus metrics at :METRICS_PORT/metrics, not to be published
# outside; empty = not served.
METRICS_PORT=

# mTLS between services (all three or none; none = plaintext, local only).
# `make certs` in the repository root creates them in certs/.
TLS_CA_PATH=
TLS_CERT_PATH=
TLS_KEY_PATH=

USER_SERVICE_ADDR=

# inmem (default, nothing to run) | persistent (PostgreSQL + Redis)
STORAGE=
DATABASE_URL=
REDIS_ADDR=
# Apply migrations on start (default true).
MIGRATE_ON_START=

# console (default, codes go to the log) | smtp | telegram (codes go to
# a chat of the site's owner, who passes them on)
MAILER=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# For MAILER=telegram: a bot of @BotFather and the chat it writes to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

HASH_SECRET=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
ISSUER=

# Optional, Go durations; defaults are 15m and 720h (30 days).
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=

# Optional sign-in code policy. Defaults: code lives 5m, 5 attempts,
# one code per email per 1m, 10 codes per IP per 1h.
CODE_TTL=
CODE_MAX_ATTEMPTS=
CODE_RESEND_INTERVAL=
CODE_REQUESTS_PER_IP=
CODE_REQUESTS_WINDOW=
