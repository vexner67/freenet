GRPC_PORT=
LOG_LEVEL=
LOG_FORMAT=
# Prometheus metrics at :METRICS_PORT/metrics, not to be published
# outside; empty = not served.
METRICS_PORT=

# mTLS between services (all three or none; none = plaintext, local only).
# `make certs` in the repository root creates them in certs/.
TLS_CA_PATH=
TLS_CERT_PATH=
TLS_KEY_PATH=

USER_SERVICE_ADDR=

# inmem (default, nothing to run) | persistent (PostgreSQL + Redis)
STORAGE=
DATABASE_URL=
REDIS_ADDR=
# Apply migrations on start (default true).
MIGRATE_ON_START=

# console (default, codes go to the log) | smtp | telegram (codes go to
# a chat of the site's owner, who passes them on)
MAILER=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# For MAILER=telegram: a bot of @BotFather and the chat it writes to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

HASH_SECRET=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
ISSUER=

# Optional, Go durations; defaults are 15m and 720h (30 days).
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=

# Optional picture to read before a code is mailed: off by default,
# on in production. It lives 5m, 60 pictures per IP per 10m.
# CAPTCHA_REQUIRED=true
# CAPTCHA_TTL=5m
# CAPTCHA_PER_IP=60
# CAPTCHA_WINDOW=10m

# Optional sign-in code policy. Defaults: code lives 5m, 5 attempts,
# one code per email per 1m, 10 codes per IP per 1h.
CODE_TTL=
CODE_MAX_ATTEMPTS=
CODE_RESEND_INTERVAL=
CODE_REQUESTS_PER_IP=
CODE_REQUESTS_WINDOW=

# Optional second step of signing in with an authenticator app. Defaults:
# the site is "Freenet" in the app, the code of the app may come 10m after
# the email code, 10 codes of a page are checked per 1h.
TWO_FACTOR_ISSUER=
TWO_FACTOR_TICKET_TTL=
TWO_FACTOR_CHECKS_PER_USER=
TWO_FACTOR_CHECKS_WINDOW=

# Optional: host:port of a collector taking OTLP over gRPC (Jaeger in the
# Docker stack), for a trace of every request through the services; without
# it nothing is traced. TRACING_SAMPLE_RATIO is the share of requests
# traced, from 0 to 1 (default 1).
TRACING_ENDPOINT=
TRACING_SAMPLE_RATIO=
