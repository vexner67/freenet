GRPC_PORT=
LOG_LEVEL=
LOG_FORMAT=
# Prometheus metrics at :METRICS_PORT/metrics, not to be published
# outside; empty = not served.
METRICS_PORT=

# mTLS between services (all three or none; none = plaintext, local only).
# `make certs` in the repository root creates them in certs/.
TLS_CA_PATH=
TLS_CERT_PATH=
TLS_KEY_PATH=

# inmem (default, nothing to run) | persistent (PostgreSQL)
STORAGE=
DATABASE_URL=
# Apply migrations on start (default true).
MIGRATE_ON_START=

# Where the site is on the web: the addresses of its pages in the
# Fediverse begin with it (default http://localhost:8080; other servers
# reach only https).
PUBLIC_URL=

# The pages and posts come from the user and post services, each call
# within SERVICES_TIMEOUT (default 2s).
USER_SERVICE_ADDR=
POST_SERVICE_ADDR=
SERVICES_TIMEOUT=

# A request to another server (default 10s); an activity it does not take
# is sent again until DELIVERY_MAX_AGE after it was made (default 48h).
REMOTE_TIMEOUT=
DELIVERY_MAX_AGE=

# The languages of the remote posts in the news of everyone, comma
# separated (default ru,en); a post that does not say its language is
# there too.
FEED_LANGUAGES=
# How long remote posts are kept (default 2160h, 90 days), and how often
# older ones are forgotten (default 1h).
NEWS_RETENTION=
CLEANUP_INTERVAL=
# The program that cuts the first frames of videos with no cover, for
# the news (default ffmpeg, looked for in PATH), each within FRAME_TIMEOUT
# (default 20s); without it such videos show a blurred cover.
FFMPEG_PATH=
FRAME_TIMEOUT=

JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=

# Optional: host:port of a collector taking OTLP over gRPC (Jaeger in the
# Docker stack), for a trace of every request through the services; without
# it nothing is traced. TRACING_SAMPLE_RATIO is the share of requests
# traced, from 0 to 1 (default 1).
TRACING_ENDPOINT=
TRACING_SAMPLE_RATIO=
