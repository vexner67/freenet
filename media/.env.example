GRPC_PORT=
LOG_LEVEL=
LOG_FORMAT=
# Prometheus metrics at :METRICS_PORT/metrics, not to be published
# outside; empty = not served.
METRICS_PORT=

# mTLS between services (all three or none; none = plaintext, local only).
# `make certs` in the repository root creates them in certs/.
TLS_CA_PATH=
TLS_CERT_PATH=
TLS_KEY_PATH=

# inmem (default, nothing to set up) | persistent (files under MEDIA_DIR)
STORAGE=
MEDIA_DIR=

# A photo uploaded for a post that is never published is gone for its
# owner after UNPUBLISHED_PHOTO_TTL (default 24h); uploads are looked
# through every PHOTO_CLEANUP_INTERVAL (default 1h). The files are set
# aside until RETIRED_PHOTO_TTL after the upload (default 720h, not shorter
# than UNPUBLISHED_PHOTO_TTL): a post published while the outbox of its
# service was stuck still gets its photos when the word arrives.
UNPUBLISHED_PHOTO_TTL=
PHOTO_CLEANUP_INTERVAL=
RETIRED_PHOTO_TTL=

# Spam protection per user, as "limit/window,...". REDIS_ADDR shares the
# counters between replicas; without it they are kept in memory.
REDIS_ADDR=
# Defaults: 30/1m,300/24h; 5/1m,30/24h.
RATE_LIMIT_PHOTOS=
RATE_LIMIT_AVATARS=

JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=
