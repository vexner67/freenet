GRPC_PORT=
LOG_LEVEL=
LOG_FORMAT=
# Prometheus metrics at :METRICS_PORT/metrics, not to be published
# outside; empty = not served.
METRICS_PORT=

# mTLS between services (all three or none; none = plaintext, local only).
# `make certs` in the repository root creates them in certs/.
TLS_CA_PATH=
TLS_CERT_PATH=
TLS_KEY_PATH=

# inmem (default, nothing to set up) | persistent (files under MEDIA_DIR,
# one node) | s3 (a bucket, for several replicas)
STORAGE=
MEDIA_DIR=
# STORAGE=s3: S3_ENDPOINT is host[:port] of an S3-compatible storage that
# takes conditional writes (If-None-Match: AWS S3, MinIO); the bucket must
# exist. S3_REGION defaults to us-east-1, S3_PREFIX goes before every key,
# S3_INSECURE=true talks plain HTTP (a MinIO next to the service).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=
S3_INSECURE=

# A photo uploaded for a post that is never published is gone for its
# owner after UNPUBLISHED_PHOTO_TTL (default 24h); uploads are looked
# through every PHOTO_CLEANUP_INTERVAL (default 1h). The files are set
# aside until RETIRED_PHOTO_TTL after the upload (default 720h, not shorter
# than UNPUBLISHED_PHOTO_TTL): a post published while the outbox of its
# service was stuck still gets its photos when the word arrives.
UNPUBLISHED_PHOTO_TTL=
PHOTO_CLEANUP_INTERVAL=
RETIRED_PHOTO_TTL=
# A photo claimed for a post that failed without saying whether it was
# written may be posted again once the claim is PHOTO_CLAIM_TTL old
# (default 15m) and nothing has published the photo; 0: never. Keep it
# well above the time the outboxes of post and message take to deliver.
PHOTO_CLAIM_TTL=

# Spam protection per user, as "limit/window,...". REDIS_ADDR shares the
# counters between replicas; without it they are kept in memory.
REDIS_ADDR=
# Defaults: 30/1m,300/24h; 5/1m,30/24h.
RATE_LIMIT_PHOTOS=
RATE_LIMIT_AVATARS=
# Documents of "Мои Документы", at most 10 MB each. Defaults: 10/1m,100/24h.
RATE_LIMIT_DOCUMENTS=

JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=

# Optional: host:port of a collector taking OTLP over gRPC (Jaeger in the
# Docker stack), for a trace of every request through the services; without
# it nothing is traced. TRACING_SAMPLE_RATIO is the share of requests
# traced, from 0 to 1 (default 1).
TRACING_ENDPOINT=
TRACING_SAMPLE_RATIO=
