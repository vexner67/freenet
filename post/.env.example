GRPC_PORT=
LOG_LEVEL=
LOG_FORMAT=
# Prometheus metrics at :METRICS_PORT/metrics, not to be published
# outside; empty = not served.
METRICS_PORT=

# mTLS between services (all three or none; none = plaintext, local only).
# `make certs` in the repository root creates them in certs/.
TLS_CA_PATH=
TLS_CERT_PATH=
TLS_KEY_PATH=

# inmem (default, nothing to run) | persistent (PostgreSQL)
STORAGE=
DATABASE_URL=
# Apply migrations on start (default true).
MIGRATE_ON_START=

# Spam protection per user, as "limit/window,...". REDIS_ADDR shares the
# counters between replicas; without it they are kept in memory.
REDIS_ADDR=
# Defaults: 5/1m,100/24h; 20/1m,500/24h; 60/1m,1000/24h; 10/1m,200/24h.
# Reposts follow RATE_LIMIT_POSTS, counted apart from posts.
RATE_LIMIT_POSTS=
RATE_LIMIT_COMMENTS=
RATE_LIMIT_LIKES=
RATE_LIMIT_POST_EDITS=

# Optional: without it likes and comments notify nobody.
NOTIFICATION_SERVICE_ADDR=
# Timeout of one call to the notification or media service (default 2s).
NOTIFY_TIMEOUT=
# Where post tells media which photos its posts publish and delete.
# Without it media deletes the photos of posts as never published.
MEDIA_SERVICE_ADDR=
# Whom post asks whether someone keeps a community's wall clean (its
# admins). Without it only the authors delete on community walls.
CLUB_SERVICE_ADDR=

# How often the postponed posts whose time has come are published
# (default 30s): a post comes out up to this late.
POSTPONED_INTERVAL=

# How often the stories whose day is over are deleted with their photos
# (default 10m); until then nobody sees them anyway.
STORY_CLEANUP_INTERVAL=

JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=

# Optional: host:port of a collector taking OTLP over gRPC (Jaeger in the
# Docker stack), for a trace of every request through the services; without
# it nothing is traced. TRACING_SAMPLE_RATIO is the share of requests
# traced, from 0 to 1 (default 1).
TRACING_ENDPOINT=
TRACING_SAMPLE_RATIO=
