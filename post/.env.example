GRPC_PORT=
LOG_LEVEL=
LOG_FORMAT=
# Prometheus metrics at :METRICS_PORT/metrics, not to be published
# outside; empty = not served.
METRICS_PORT=

# mTLS between services (all three or none; none = plaintext, local only).
# `make certs` in the repository root creates them in certs/.
TLS_CA_PATH=
TLS_CERT_PATH=
TLS_KEY_PATH=

# inmem (default, nothing to run) | persistent (PostgreSQL)
STORAGE=
DATABASE_URL=
# Apply migrations on start (default true).
MIGRATE_ON_START=

# Spam protection per user, as "limit/window,...". REDIS_ADDR shares the
# counters between replicas; without it they are kept in memory.
REDIS_ADDR=
# Defaults: 5/1m,100/24h; 20/1m,500/24h; 60/1m,1000/24h. Reposts follow
# RATE_LIMIT_POSTS, counted apart from posts.
RATE_LIMIT_POSTS=
RATE_LIMIT_COMMENTS=
RATE_LIMIT_LIKES=

# Optional: without it likes and comments notify nobody.
NOTIFICATION_SERVICE_ADDR=
# Timeout of one call to the notification or media service (default 2s).
NOTIFY_TIMEOUT=
# Where post tells media which photos its posts publish and delete.
# Without it media deletes the photos of posts as never published.
MEDIA_SERVICE_ADDR=

JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=
