GRPC_PORT=7059
METRICS_PORT=9059
LOG_LEVEL=info
LOG_FORMAT=text
STORAGE=inmem
DATABASE_URL=postgres://freenet:development-room-db@localhost:5440/freenet?sslmode=disable
REDIS_ADDR=
MIGRATE_ON_START=true
DATABASE_READ_TIMEOUT=2s
TLS_CA_PATH=
TLS_CERT_PATH=
TLS_KEY_PATH=
JWT_PUBLIC_KEY_PATH=../certs/jwt-public.pem
JWT_ISSUER=freenet-auth
USER_SERVICE_ADDR=localhost:7052
CLUB_SERVICE_ADDR=localhost:7057
NOTIFICATION_SERVICE_ADDR=localhost:7055
SERVICES_TIMEOUT=2s
CONNECT_TIMEOUT=5s
MIGRATION_TIMEOUT=1m
PROBE_TIMEOUT=3s
# Local development credentials only. Production generates its own secrets.
LIVEKIT_URL=http://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:8080
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_TIMEOUT=3s
LIVEKIT_TOKEN_TTL=10m
ROOM_MAX_MEMBERS=5
ROOM_MAX_LIVE=20
ROOM_EMPTY_TTL=5m
ROOM_STATE_TTL=24h
ROOM_SWEEP_INTERVAL=10s
RATE_LIMIT_ROOMS=5/1h
RATE_LIMIT_ROOM_JOINS=30/1m
RATE_LIMIT_ROOM_CHAT=30/1m,1000/24h
RATE_LIMIT_ROOM_PLAYBACK=60/1m
RATE_LIMIT_ROOM_INVITES=30/1h,100/24h
RATE_LIMIT_ROOM_MANAGEMENT=60/1m
TRACING_ENDPOINT=
