HTTP_PORT=
LOG_LEVEL=
LOG_FORMAT=
# Prometheus metrics at :METRICS_PORT/metrics, not to be published
# outside; empty = not served.
METRICS_PORT=

AUTH_SERVICE_ADDR=
USER_SERVICE_ADDR=
POST_SERVICE_ADDR=
MEDIA_SERVICE_ADDR=
NOTIFICATION_SERVICE_ADDR=
MESSAGE_SERVICE_ADDR=
CLUB_SERVICE_ADDR=
WORLD_SERVICE_ADDR=

# mTLS to internal services (all three or none; none = plaintext, local only).
# `make certs` in the repository root creates them in certs/.
TLS_CA_PATH=
TLS_CERT_PATH=
TLS_KEY_PATH=

# Comma-separated web origins allowed to call the API.
CORS_ALLOWED_ORIGINS=
# true only behind a proxy that sets X-Forwarded-For (and X-Request-ID).
TRUST_FORWARDED_FOR=
# Go duration, default 10s.
REQUEST_TIMEOUT=
# How long the numbers of the page "о сайте" are kept before they are
# counted again. Go duration, default 1m; 0 counts on every request.
STATISTICS_TTL=
# How long a new post may wait for the page it links to, for its card.
# Go duration, default 4s, shorter than REQUEST_TIMEOUT; 0 = no cards.
LINK_PREVIEW_TIMEOUT=
# Website to serve on the same origin, e.g. ../web; empty = API only.
WEB_DIR=

# Optional: host:port of a collector taking OTLP over gRPC (Jaeger in the
# Docker stack), for a trace of every request through the services; without
# it nothing is traced. TRACING_SAMPLE_RATIO is the share of requests
# traced, from 0 to 1 (default 1).
TRACING_ENDPOINT=
TRACING_SAMPLE_RATIO=
