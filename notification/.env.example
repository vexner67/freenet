GRPC_PORT=
LOG_LEVEL=
LOG_FORMAT=
# Prometheus metrics at :METRICS_PORT/metrics, not to be published
# outside; empty = not served.
METRICS_PORT=

# mTLS between services (all three or none; none = plaintext, local only).
# `make certs` in the repository root creates them in certs/.
TLS_CA_PATH=
TLS_CERT_PATH=
TLS_KEY_PATH=

# inmem (default, nothing to run) | persistent (PostgreSQL)
STORAGE=
DATABASE_URL=
# Apply migrations on start (default true).
MIGRATE_ON_START=

# Shares live events between replicas; without it they stay in one.
REDIS_ADDR=

# How long a notification is kept (Go duration, default 4320h, 180 days):
# older ones are deleted, read or not. And how often (default 1h).
NOTIFICATION_RETENTION=
NOTIFICATION_CLEANUP_INTERVAL=

# Push notifications to browsers (Web Push): the VAPID private key, P-256
# in PEM (`make certs` writes certs/push-key.pem); empty = no pushes.
PUSH_KEY_PATH=
# Whom the push services may contact: a mailto: or https URL (default the
# repository).
PUSH_SUBJECT=
# Pushing one event to all browsers of a user (default 10s); how many
# events may wait (default 1000, more are dropped) and how many are pushed
# at once (default 4).
PUSH_TIMEOUT=
PUSH_QUEUE=
PUSH_WORKERS=
# Who did what a push tells of is asked of the user and club services
# (each call within PEOPLE_TIMEOUT, default 2s); without them pushes name
# nobody.
USER_SERVICE_ADDR=
CLUB_SERVICE_ADDR=
PEOPLE_TIMEOUT=

JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=

# Optional: host:port of a collector taking OTLP over gRPC (Jaeger in the
# Docker stack), for a trace of every request through the services; without
# it nothing is traced. TRACING_SAMPLE_RATIO is the share of requests
# traced, from 0 to 1 (default 1).
TRACING_ENDPOINT=
TRACING_SAMPLE_RATIO=
